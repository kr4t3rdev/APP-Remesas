# ============================================
# Variables de Entorno - App Finance
# ============================================
# Copia este archivo como .env y configura tus valores
# Nota: Las variables deben empezar con EXPO_PUBLIC_ para ser accesibles

# --------------------------------------------
# URLs del Servidor API
# --------------------------------------------

# URL para compilación WEB (por defecto: localhost)
EXPO_PUBLIC_WEB_API_URL=http://localhost:3000/api

# URL para dispositivos físicos en red local (por defecto: 192.168.1.100)
# Cambia esta IP por la dirección de tu computadora en la red local
EXPO_PUBLIC_PHYSICAL_API_URL=http://192.168.1.100:3000/api

# URL de producción
EXPO_PUBLIC_PROD_API_URL=https://tu-dominio-production.com/api
